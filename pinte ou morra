local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Referência para a interface do jogador (exemplo de nome: MainMenu)
local screenGui = playerGui:WaitForChild("MainMenu")

-- Alterna a visibilidade ao pressionar a tecla K
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- Evita ativar o atalho enquanto o jogador digita no chat
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.K then
        screenGui.Enabled = not screenGui.Enabled
    end
end)
